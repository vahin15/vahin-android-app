<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude local chat histories, media caches, and encryption keys from Google Cloud backup -->
        <exclude domain="database" path="." />
        <exclude domain="file" path="shared_files/" />
        <exclude domain="file" path="custom_ringtone.mp3" />
        <exclude domain="root" path="app_webview/" />
        <exclude domain="sharedpref" path="vahin_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Disallow sensitive cached media transfer on direct device migration -->
        <exclude domain="file" path="shared_files/" />
        <exclude domain="root" path="app_webview/Default/Cache/" />
    </device-transfer>
</data-extraction-rules>
