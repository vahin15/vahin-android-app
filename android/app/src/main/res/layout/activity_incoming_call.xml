<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E1A"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Background glow / gradient aura -->
    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:background="@drawable/bg_call_avatar"
        android:alpha="0.08" />

    <!-- Top info container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="56dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <TextView
            android:id="@+id/incoming_call_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_call_badge"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.04"
            android:text="🔒 P2P End-to-End Encrypted"
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <!-- Large Circular Avatar with initial -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="36dp"
            android:layout_marginBottom="24dp">

            <View
                android:id="@+id/incoming_avatar_pulse"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:background="@drawable/bg_call_avatar"
                android:alpha="0.35" />

            <TextView
                android:id="@+id/incoming_call_avatar"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_avatar"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="U"
                android:textColor="#FFFFFF"
                android:textSize="44sp" />
        </FrameLayout>

        <!-- Caller Name -->
        <TextView
            android:id="@+id/incoming_call_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="Caller"
            android:textColor="#FFFFFF"
            android:textSize="32sp" />

        <!-- Call Type Subtitle -->
        <TextView
            android:id="@+id/incoming_call_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="Incoming Call · Unifest"
            android:textColor="#94A3B8"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Bottom Action Controls with Circular Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="64dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <!-- Decline Action (Circular) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_incoming_decline"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_decline"
                android:contentDescription="Decline Call"
                android:elevation="6dp"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_decline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Decline"
                android:textColor="#F87171"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Accept Action (Circular) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btn_incoming_accept"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_call_accept"
                android:contentDescription="Accept Call"
                android:elevation="6dp"
                android:padding="20dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_accept" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Accept"
                android:textColor="#34D399"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
