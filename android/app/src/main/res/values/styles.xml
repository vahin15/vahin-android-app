<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
    </style>

    <!-- FIX (Telecom full-screen call UI): IncomingCallActivity used to reuse
         AppTheme.NoActionBarLaunch, which extends Theme.SplashScreen — a theme meant for
         MainActivity's one-shot cold-start splash, not a persistent full-screen call
         screen. Theme.SplashScreen windows are contracted to draw once and hand off; on
         several OEMs/Android versions the system doesn't honor them as a legitimate
         full-screen-intent target and just leaves the heads-up notification in the shade
         instead of launching the activity — exactly the "falls back to a normal
         notification even though the permission is granted" symptom. A plain
         NoActionBar theme has no such special handling. -->
    <style name="AppTheme.IncomingCall" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>